rules_version = '2';
// VIBSma — Cloud Firestore security rules. Firebase console → Firestore Database → Rules → paste → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // a person's own profile, saved styles and projects
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // photos / video / audio: written once, read by id (ids are random); nobody can list them
    match /assets/{aid} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      match /parts/{p} {
        allow get: if request.auth != null;
        allow create: if request.auth != null;
      }
    }
    // shared projects: everyone with the link (and an account) can open and edit
    match /shares/{sid} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.owner == resource.data.owner;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      match /parts/{p} {
        allow get, write: if request.auth != null;
      }
      match /msgs/{m} {
        allow read, create, delete: if request.auth != null;
      }
    }
  }
}
